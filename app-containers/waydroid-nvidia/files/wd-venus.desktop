[Desktop Entry] 
Type=Application
Name=Waydroid Venus
Exec=sh -c 'mkdir -p "$XDG_RUNTIME_DIR/waydroid-venus" && LD_LIBRARY_PATH=/usr/lib/waydroid-nvidia 
RENDER_SERVER_EXEC_PATH=/usr/lib/waydroid-nvidia/virgl_render_server /usr/lib/waydroid-nvidia/virgl_test_server --venus --multi-clients 
--socket-path "$XDG_RUNTIME_DIR/waydroid-venus/venus.sock"'
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
